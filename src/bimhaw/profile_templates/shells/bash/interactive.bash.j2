#!/bin/bash

# common functionality
. "$BIMHAW_DIR/active/shells/sh/funcs.sh"

# common aliases
. "$BIMHAW_DIR/active/shells/sh/aliases.sh"

# common environments for nonlogin shells

# TODO: unify the lists of packages for the nonlogin and login
# shells. Now they are basically duplicated because of this thing
# here.

# WARN: This is needs to be called because the login_env.sh file will not be
# called when starting bash up.
. "$BIMHAW_DIR/active/shells/sh/nonlogin_env.sh"

# bash only interactive prompt configurations

# bash only envs
libs={{ bash_interactive_envs }}

for lib in $libs; do
    . "$BIMHAW_DIR/active/lib/bash/envs/${lib}.bash"
done


## Prompt customization

. "$BIMHAW_DIR/active/shells/bash/prompt.bash"

# TODO(bimhaw): post-prompt hook category.
# Interactive envs run *before* the prompt. Prompts that assign
# PROMPT_COMMAND (or rebuild PS1) clobber earlier wraps (history
# sync, Eat, direnv). Workaround today: modules append to
# PROMPT_COMMAND as an array, and Eat-like integrations are sourced
# from the prompt itself. A generated post-prompt step (or a
# BASH_POST_PROMPT_ENVS list sourced here) would let those stay
# ordinary envs. See bimker eat.bash / salotz_dark.

## autocompletion
. "$BIMHAW_DIR/active/shells/bash/autocompletion.bash"

